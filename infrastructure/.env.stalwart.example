# ==============================================================================
# Stalwart Mail Server Environment Configuration
# ==============================================================================

# Primary mail domain
MAIL_DOMAIN=mail.exoinafrica.com
BASE_DOMAIN=exoinafrica.com

# Stalwart Web Admin & REST API Administrator Credentials
# Access Web Admin at: http://<server-ip>:8081
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASS=ExoinMail@2026!

# Public IP address of the mail server (used for DNS A record)
MAIL_SERVER_IP=

# TLS / SSL Mode (ACME / Let's Encrypt or Custom Certificates)
ACME_EMAIL=admin@exoinafrica.com

# Upstream Relay (optional, e.g., if ISP blocks port 25 outbound)
# RELAY_HOST=smtp-relay.brevo.com
# RELAY_PORT=587
# RELAY_USER=
# RELAY_PASS=
